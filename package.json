{
  "name": "systemone-ts",
  "version": "0.1.0",
  "description": "Typed decisions across System One and OpenAI Decisions — by 3inch.ai Labs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:bun": "bun test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:live-local": "npm run build && node scripts/live-local.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "smoke:workers": "node scripts/workers.mjs",
    "format:check": "prettier --check src test scripts examples package.json tsconfig*.json .github/workflows/ci.yml",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run smoke && npm run smoke:workers",
    "prepack": "npm run build"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  },
  "license": "MIT",
  "author": "3inch.ai Labs",
  "homepage": "https://3inch.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3inch-ai/system1ts.git"
  },
  "bugs": {
    "url": "https://github.com/3inch-ai/system1ts/issues"
  },
  "keywords": [
    "decisions",
    "system-one",
    "jev",
    "h2o",
    "openai",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "^4.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
